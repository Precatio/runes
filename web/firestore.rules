rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // A signed-in account that the founder has not suspended. Suspension (api/routers/admin.py) disables the
    // account in Firebase Auth and writes banned/{uid}, so that access stops at once and not when the token expires.
    function active() {
      return request.auth != null
        && !exists(/databases/$(database)/documents/banned/$(request.auth.uid));
    }

    // Ensure all authenticated users can only read and write their own data
    match /users/{userId} {
      allow read, write: if active() && request.auth.uid == userId;

      // Cascade the same rule down to nested collections (projects, settings)
      match /{document=**} {
        allow read, write: if active() && request.auth.uid == userId;
      }
    }

    // Shared research corpus of groove measurements (published under CC BY 4.0).
    // Every signed-in researcher can read; entries can only be created, changed
    // or removed by their contributor.
    match /corpus/{entryId} {
      function validEntry(data) {
        return data.contributorUid == request.auth.uid
          && data.id == entryId
          && data.license == 'CC-BY-4.0'
          && data.signum is string && data.signum.size() > 0 && data.signum.size() < 64
          && data.feature_type in ['rune', 'ornament', 'unknown']
          && data.means is map
          && data.slices is list && data.slices.size() <= 200
          && data.contributorName is string && data.contributorName.size() < 200;
      }

      // Another researcher may only append one verification signed with their own uid
      function isVerification() {
        let before = resource.data.get('verifications', []);
        let after = request.resource.data.get('verifications', []);
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['verifications'])
          && after.size() == before.size() + 1
          && after[before.size()].uid == request.auth.uid
          && resource.data.contributorUid != request.auth.uid;
      }

      allow read: if active();
      allow create: if active() && validEntry(request.resource.data);
      allow update: if active() && (
        (resource.data.contributorUid == request.auth.uid && validEntry(request.resource.data))
        || isVerification()
      );
      allow delete: if active() && resource.data.contributorUid == request.auth.uid;

      // Raw profiles and rune forms: readable by all signed-in users, written by the contributor.
      // getAfter() so that a batch creating the entry and its subdocuments together is allowed.
      match /{sub}/{docId} {
        allow read: if active();
        allow create, update: if active() && sub in ['raw', 'runeforms']
          && getAfter(/databases/$(database)/documents/corpus/$(entryId)).data.contributorUid == request.auth.uid;
        allow delete: if active()
          && get(/databases/$(database)/documents/corpus/$(entryId)).data.contributorUid == request.auth.uid;
      }
    }

    // Messages from the founder (written only by the server). Messages to everyone can be read by anyone,
    // also before signing in; a personal message only by its recipient.
    match /messages/{messageId} {
      allow read: if resource.data.to == 'all' || (active() && resource.data.to == request.auth.uid);
      allow write: if false;
    }

    // Suspended accounts: written and read only by the server
    match /banned/{uid} {
      allow read, write: if false;
    }

    // Blog posts (Månadens fynd): written and read only by the server (api/routers/blog.py), which serves the
    // published ones at /api/blog/posts. Closed to browsers, as by the default rule below.
    match /posts/{postId} {
      allow read, write: if false;
    }

    // Votes from the public website (web/src/components/SiteVote.tsx): anyone may cast one, with exactly these fields
    // and values; nobody can read, change or remove votes from a browser. The founder sees the result in Admin, read
    // with the server's own access (api/routers/admin.py).
    match /site_votes/{voteId} {
      allow create: if request.resource.data.keys().hasOnly(['question', 'choice', 'lang'])
        && request.resource.data.question == 'webbapp'
        && request.resource.data.choice in ['ja', 'nej']
        && request.resource.data.lang in ['sv', 'en'];
      allow read, update, delete: if false;
    }

    // Visitor counts from the public website (web/src/components/SiteTracker.tsx): a page or a section of the start
    // page that was seen, with the referring site, time zone, language and kind of device – no identifier, no IP
    // address. Anyone may add one with exactly these fields; nobody can read, change or remove them from a browser. The
    // founder sees the summary in Admin (api/routers/admin.py).
    function optionalString(d, key, max) {
      return !(key in d) || (d[key] is string && d[key].size() <= max);
    }
    match /site_views/{viewId} {
      allow create: if request.resource.data.keys().hasOnly(['kind', 'path', 'section', 'entry', 'ref', 'tz', 'lang', 'device', 'day', 'prev', 'via', 'label', 'hits'])
        && request.resource.data.keys().hasAll(['kind', 'path', 'day'])
        && request.resource.data.kind in ['view', 'section', 'search', 'click']
        && optionalString(request.resource.data, 'prev', 200)
        && (!('via' in request.resource.data) || request.resource.data.via in ['lank', 'enhet', 'x', 'facebook', 'linkedin', 'epost'])
        && optionalString(request.resource.data, 'label', 80)
        && (!('hits' in request.resource.data) || (request.resource.data.hits is int && request.resource.data.hits >= 0 && request.resource.data.hits <= 1000))
        && request.resource.data.path is string && request.resource.data.path.size() <= 200
        && request.resource.data.day is string && request.resource.data.day.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && (!('entry' in request.resource.data) || request.resource.data.entry is bool)
        && (!('device' in request.resource.data) || request.resource.data.device in ['mobil', 'surfplatta', 'dator'])
        && optionalString(request.resource.data, 'section', 40)
        && optionalString(request.resource.data, 'ref', 100)
        && optionalString(request.resource.data, 'tz', 60)
        && optionalString(request.resource.data, 'lang', 12);
      allow read, update, delete: if false;
    }

    // Deny access to everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
